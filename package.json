{
  "name": "adfree-music",
  "version": "1.3.1",
  "description": "YouTube & YouTube Music tanpa iklan",
  "main": "src/main.js",
  "scripts": {
    "build:core": "node shared/build-core.js",
    "build:preload": "npm run build:core && esbuild src/preload.js --bundle --platform=node --external:electron --outfile=src/preload.bundle.js",
    "prestart": "npm run build:preload",
    "start": "electron .",
    "pretest": "npm run build:core",
    "test": "node --test tests/*.test.js",
    "predist": "npm run build:preload",
    "dist": "electron-builder --win"
  },
  "__comment": "shared/adfree-core.js hasil generate — edit shared/src/core/*.js",
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2"
  },
  "productName": "AdFree Music",
  "build": {
    "appId": "com.fadlan.adfreemusic",
    "productName": "AdFree Music",
    "files": [
      "src/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
